<view class="page">
  <view class="head fade-in">
    <view class="kicker">JOURNEYS</view>
    <view class="head-title">航班与车次</view>
    <view class="head-sub">怎么去的，和去写了字的地方一样值得记</view>
  </view>

  <view wx:if="{{!journeys.length}}" class="empty">
    <view class="empty-icon">✈</view>
    <view class="empty-text">暂无行程记录</view>
  </view>

  <view class="list">
    <view
      wx:for="{{journeys}}"
      wx:key="index"
      class="journey fade-in"
      style="animation-delay: {{index * 0.05}}s"
    >
      <view class="j-mode {{item.mode === 'flight' ? 'j-flight' : 'j-train'}}">
        {{item.mode === 'flight' ? '✈' : '🚄'}}
      </view>
      <view class="j-body">
        <view class="j-route">
          <text class="j-city">{{item.from.name}}</text>
          <text class="j-dash"></text>
          <text class="j-city">{{item.to.name}}</text>
        </view>
        <view class="j-meta">
          <text>{{item.date}}</text>
          <text wx:if="{{item.no}}"> · {{item.modeLabel[item.mode]}} {{item.no}}</text>
        </view>
      </view>
      <view class="j-side">
        <text wx:if="{{item.trip}}" class="j-link" hover-class="j-link-hover" bindtap="openTrip" data-trip="{{item.trip}}">手帖 ›</text>
      </view>
    </view>
  </view>

  <view class="foot" bindtap="openMap">在地图上看这些线 ›</view>
</view>
