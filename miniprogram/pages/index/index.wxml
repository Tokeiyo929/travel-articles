<view class="page">
  <view class="hero fade-in">
    <view class="kicker">TRAVEL NOTES</view>
    <view class="hero-title">把走过的路，写成字</view>
    <view class="hero-sub">{{trips.length}} 篇手帖 · 照片会褪色，坐标不会</view>
    <view class="entries">
      <view class="map-entry" hover-class="map-entry-hover" bindtap="openMap">
        <text class="accent">◈</text> 旅程地图 <text class="map-arrow">›</text>
      </view>
      <view class="map-entry" hover-class="map-entry-hover" bindtap="openJourney">
        <text class="accent">✈</text> 行程足迹 <text class="map-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="list">
    <view
      wx:for="{{trips}}"
      wx:key="id"
      class="card fade-in"
      style="animation-delay: {{index * 0.08}}s"
      hover-class="card-hover"
      bindtap="open"
      data-id="{{item.id}}"
    >
      <view class="cover-wrap">
        <image class="cover" src="{{item.cover}}" mode="aspectFill" webp="{{true}}" />
        <view class="stamp">{{item.location}}</view>
      </view>
      <view class="body">
        <view class="title">{{item.title}}</view>
        <view class="meta"><text class="accent">◆</text> {{item.location}} · {{item.date}}</view>
        <view class="excerpt">{{item.excerpt}}</view>
        <view class="spots">
          <text wx:for="{{item.spots}}" wx:for-item="s" wx:key="*this" class="spot">{{s}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="foot">山河手帖 · 旅行笔记</view>
</view>
