/* 竖屏首页：hero + 竖排卡片流（微慕/酱茄列表惯例） */
.page {
  min-height: 100vh;
  padding: 0 0 32px;
}

.hero {
  padding: 36px 24px 26px;
  border-bottom: 3px double #e2d9c8;
}
.hero-title {
  margin-top: 10px;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 2px;
}
.hero-sub {
  margin-top: 8px;
  font-size: 13px;
  color: #6b6257;
}
.map-entry {
  display: inline-flex;
  align-items: center;
  margin-top: 16px;
  padding: 7px 14px;
  font-size: 13px;
  letter-spacing: 1px;
  color: #2c2620;
  border: 1px solid #a4452c;
}
.map-entry-hover { background: rgba(164, 69, 44, 0.06); }
.map-arrow { color: #a4452c; margin-left: 2px; }

.list {
  padding: 22px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.card {
  background: #fffdf8;
  border: 1px solid #e2d9c8;
  overflow: hidden;
  transition: box-shadow .25s ease;
}
.card-hover { box-shadow: 0 10px 26px rgba(60, 45, 25, 0.12); }

.cover-wrap { position: relative; }
.cover {
  width: 100%;
  height: 400rpx;
  display: block;
}
.stamp {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(44, 38, 32, 0.78);
  color: #f4ede1;
  font-size: 11px;
  letter-spacing: 2px;
  padding: 3px 10px;
}

.body {
  padding: 16px 18px 14px;
}
.title {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.5;
}
.meta {
  margin-top: 6px;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 1px;
}
.excerpt {
  margin-top: 10px;
  font-size: 13px;
  color: #6b6257;
  line-height: 1.75;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.spots {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.spot {
  font-size: 11px;
  color: #a4452c;
  border: 1px solid currentColor;
  padding: 1px 8px;
  letter-spacing: 1px;
  opacity: 0.85;
}

.foot {
  margin-top: 30px;
  text-align: center;
  font-size: 11px;
  letter-spacing: 2px;
  color: #a99f90;
}
