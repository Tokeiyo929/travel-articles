/* 地图即首页 v2：全屏可拖动大地图（movable 双指缩放），纸色风格保留 */

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f8f4ec;
}

.map-area {
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.map-view {
  /* 尺寸由 js 以 px 内联（屏宽 2.4 倍） */
}
.map-canvas {
  position: relative;
  background: #fffdf8;
}
.map-img {
  display: block;
}
.routes-img {
  position: absolute;
  left: 0;
  top: 0;
}

/* 标记：锚点在地图画布内的百分比处（与 svg 同一投影），随拖动缩放联动 */
.marker {
  position: absolute;
  width: 0;
  height: 0;
  padding: 12px; /* 扩大点按热区 */
}
.dot {
  position: absolute;
  left: -5px;
  top: -5px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #a4452c;
  box-shadow: 0 0 0 2px #f8f4ec;
}
.pulse {
  position: absolute;
  left: -5px;
  top: -5px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1.5px solid #a4452c;
  animation: pulse 2.4s ease-out infinite;
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 0.9; }
  100% { transform: scale(3.6); opacity: 0; }
}
.label {
  position: absolute;
  left: 12px;
  top: -16px;
  background: rgba(255, 253, 248, 0.94);
  border: 1px solid #e2d9c8;
  border-radius: 2px;
  padding: 3px 9px;
  white-space: nowrap;
}
/* 有手帖的城市：品牌红边提示可点 */
.label-link {
  border-color: #a4452c;
  box-shadow: 0 2px 8px rgba(164, 69, 44, 0.14);
}
.label-left {
  left: auto;
  right: 12px;
  text-align: right;
}
.label-name {
  font-size: 14px;
  font-weight: 700;
  color: #2c2620;
}
.label-country {
  font-size: 11px;
  color: #6b6257;
  margin-left: 4px;
}

/* 浮层：品牌条（上）与统计条（下），不拦截地图拖动 */
.brand {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  padding: 12px 16px 10px;
  background: linear-gradient(to bottom, rgba(248, 244, 236, 0.96), rgba(248, 244, 236, 0.75) 70%, rgba(248, 244, 236, 0));
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #2c2620;
  pointer-events: none;
}
.stats {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10px 16px calc(14px + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(248, 244, 236, 0.96), rgba(248, 244, 236, 0.75) 70%, rgba(248, 244, 236, 0));
  text-align: center;
  font-size: 13px;
  letter-spacing: 1px;
  color: #6b6257;
  pointer-events: none;
}
.accent { color: #a4452c; }
