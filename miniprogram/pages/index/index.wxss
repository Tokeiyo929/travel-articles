/* 横屏首页：左竖排品牌 + 右封面卡片架 */
.stage {
  height: 100vh;
  display: flex;
  align-items: stretch;
  padding: 0 calc(20px + env(safe-area-inset-right)) 0 calc(20px + env(safe-area-inset-left));
}

/* 左侧品牌栏 */
.rail {
  width: 96px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28px 0 20px;
}
.brand {
  writing-mode: vertical-rl;
  letter-spacing: 14px;
  font-size: 24px;
  font-weight: 700;
  color: #2c2620;
}
.rail-line {
  flex: 1;
  width: 1px;
  background: #e2d9c8;
  margin: 18px 0;
}
.rail-sub {
  writing-mode: vertical-rl;
  font-size: 11px;
  letter-spacing: 4px;
  color: #6b6257;
}

/* 右侧卡片架 */
.shelf {
  flex: 1;
  height: 100vh;
}
.cards {
  display: flex;
  align-items: center;
  height: 100vh;
  padding: 0 8px;
  gap: 26px;
}

.card {
  position: relative;
  width: 56vw;
  max-width: 560px;
  height: 82vh;
  max-height: 560px;
  flex-shrink: 0;
  background: #fffdf8;
  border: 1px solid #e2d9c8;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: box-shadow .25s ease;
}
.card-hover { box-shadow: 0 14px 34px rgba(60, 45, 25, 0.14); }

.cover {
  width: 100%;
  height: 46%;
  display: block;
}
.stamp {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(44, 38, 32, 0.78);
  color: #f4ede1;
  font-size: 11px;
  letter-spacing: 2px;
  padding: 3px 10px;
}
.card-body {
  flex: 1;
  padding: 16px 20px 14px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.card-title {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.5;
}
.card-meta {
  margin-top: 6px;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 1px;
}
.card-excerpt {
  margin-top: 10px;
  flex: 1;
  font-size: 13px;
  color: #6b6257;
  line-height: 1.75;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.spots {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.spot {
  font-size: 11px;
  color: #a4452c;
  border: 1px solid currentColor;
  padding: 1px 8px;
  letter-spacing: 1px;
  opacity: 0.85;
}
