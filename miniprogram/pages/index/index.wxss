/* 地图即首页：通栏大地图 + 可点城市标记 */

.page {
  min-height: 100vh;
  padding: 0 0 40px;
}

.hero {
  padding: 26px 24px 20px;
  border-bottom: 3px double #e2d9c8;
  background: #f8f4ec;
}
.kicker {
  font-size: 10px;
  letter-spacing: 5px;
  color: #a99f90;
}
.hero-title {
  margin-top: 8px;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 3px;
}

/* 通栏地图：纸色底、无左右边框，视觉主体 */
.map-wrap {
  position: relative;
  background: #fffdf8;
  box-shadow: 0 8px 22px rgba(60, 45, 25, 0.08);
}
.map {
  width: 100%;
  display: block;
}
.routes {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 标记：锚点落在经纬换算的百分比处（与 svg 同一投影） */
.marker {
  position: absolute;
  width: 0;
  height: 0;
  padding: 10px; /* 扩大点按热区 */
}
.dot {
  position: absolute;
  left: -5px;
  top: -5px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #a4452c;
  box-shadow: 0 0 0 2px #f8f4ec;
}
.pulse {
  position: absolute;
  left: -5px;
  top: -5px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1.5px solid #a4452c;
  animation: pulse 2.4s ease-out infinite;
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 0.9; }
  100% { transform: scale(3.6); opacity: 0; }
}
.label {
  position: absolute;
  left: 10px;
  top: -14px;
  background: rgba(255, 253, 248, 0.94);
  border: 1px solid #e2d9c8;
  border-radius: 2px;
  padding: 3px 8px;
  white-space: nowrap;
}
/* 有手帖的城市：品牌红边提示可点 */
.label-link {
  border-color: #a4452c;
  box-shadow: 0 2px 8px rgba(164, 69, 44, 0.14);
}
.label-left {
  left: auto;
  right: 10px;
  text-align: right;
}
.label-name {
  font-size: 13px;
  font-weight: 700;
  color: #2c2620;
}
.label-country {
  font-size: 10px;
  color: #6b6257;
  margin-left: 4px;
}

.stats {
  margin: 26px 0 10px;
  text-align: center;
  font-size: 14px;
  color: #6b6257;
  letter-spacing: 1px;
}
.accent { color: #a4452c; }

.foot {
  margin-top: 18px;
  text-align: center;
  font-size: 11px;
  letter-spacing: 4px;
  color: #a99f90;
}

.fade-in {
  animation: fadeIn .5s ease both;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: none; }
}
