/* 旅程地图：自绘纸色世界地图 + 城市标记叠层 */

.page {
  min-height: 100vh;
  padding: 18px 20px 40px;
}

.map-wrap {
  position: relative;
  border: 1px solid #e2d9c8;
  background: #fffdf8;
  box-shadow: 0 6px 18px rgba(60, 45, 25, 0.07);
}
.map {
  width: 100%;
  display: block;
}

/* 标记：锚点落在经纬换算的百分比处（与 svg 同一投影） */
.marker {
  position: absolute;
  width: 0;
  height: 0;
}
.dot {
  position: absolute;
  left: -5px;
  top: -5px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #a4452c;
  box-shadow: 0 0 0 2px #f8f4ec;
}
.pulse {
  position: absolute;
  left: -5px;
  top: -5px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1.5px solid #a4452c;
  animation: pulse 2.4s ease-out infinite;
}
@keyframes pulse {
  0% { transform: scale(1); opacity: 0.9; }
  100% { transform: scale(3.6); opacity: 0; }
}
.label {
  position: absolute;
  left: 10px;
  top: -14px;
  background: rgba(255, 253, 248, 0.94);
  border: 1px solid #e2d9c8;
  border-radius: 2px;
  padding: 2px 7px;
  white-space: nowrap;
}
.label-left {
  left: auto;
  right: 10px;
  text-align: right;
}
.label-name {
  font-size: 12px;
  font-weight: 700;
  color: #2c2620;
}
.label-country {
  font-size: 10px;
  color: #6b6257;
  margin-left: 4px;
}

.stats {
  margin: 18px 0 14px;
  text-align: center;
  font-size: 14px;
  color: #6b6257;
  letter-spacing: 1px;
}

.cities {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.city {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffdf8;
  border: 1px solid #e2d9c8;
  padding: 12px 16px;
  transition: box-shadow .2s ease;
}
.city-hover { box-shadow: 0 8px 20px rgba(60, 45, 25, 0.10); }
.city-main {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.city-name {
  font-size: 16px;
  font-weight: 700;
}
.city-country {
  font-size: 12px;
  color: #6b6257;
}
.city-link {
  font-size: 12px;
  color: #a4452c;
  letter-spacing: 1px;
}
.city-link-none {
  color: #a99f90;
}

.foot {
  margin-top: 26px;
  text-align: center;
  font-size: 11px;
  letter-spacing: 3px;
  color: #a99f90;
}
