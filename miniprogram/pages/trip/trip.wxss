/* 横屏阅读页 · 按成熟阅读器范式排版
   数值依据：foliate-js（图片 max-height=视口−边距）、Ghost Casper（文字列 720px 上限）、
   WeUI article（17px/1.6）、微信读书（长文行高 1.9、段距≈1em） */

/* 自绘顶栏 */
.bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  height: 44px;
  display: flex;
  align-items: center;
  padding-left: calc(14px + env(safe-area-inset-left));
  padding-right: calc(14px + env(safe-area-inset-right));
  background: rgba(248, 244, 236, 0.94);
  border-bottom: 1px solid #e2d9c8;
}
.back {
  font-size: 13px;
  color: #a4452c;
  padding: 6px 4px;
  letter-spacing: 1px;
}
.back-hover { opacity: 0.6; }
.bar-title {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #6b6257;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bar-side { width: 72px; }

.page {
  padding: 52px calc(20px + env(safe-area-inset-right)) 40px calc(20px + env(safe-area-inset-left));
}

/* 内容列：上限 680px（≈42 字/行），居中，不设比例 */
.col {
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
}

/* 文头 */
.head {
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e2d9c8;
}
.head-title {
  margin-top: 6px;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.4;
}
.head-meta {
  margin-top: 6px;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 1px;
}
.head-spots {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* 小标题：上松下紧 */
.h1 {
  display: flex;
  align-items: center;
  margin: 28px auto 8px;
}
.h1-bar {
  width: 4px;
  height: 17px;
  background: #a4452c;
  margin-right: 10px;
}
.h1-x {
  font-size: 18px;
  font-weight: 700;
}

/* 正文：16px / 1.8，段距约半个行高 */
.para {
  display: block;
  margin: 0 auto 14px;
  font-size: 16px;
  line-height: 1.8;
  text-align: justify;
}

/* 图与视频：限高 62vh 整图可见（foliate 规则），册页装裱式居中 */
.fig {
  margin: 18px auto;
}
.fig-media {
  width: 100%;
  height: 62vh;
  display: block;
  background: #efe9dc;
  border: 1px solid #e2d9c8;
  border-radius: 2px;
}
.fig-video {
  background: #1c1a17;
}
.fig-cap {
  margin-top: 7px;
  text-align: center;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 0.5px;
}

/* 手记清单 */
.li {
  display: flex;
  margin: 5px auto;
  font-size: 15px;
  line-height: 1.8;
}
.li-dot {
  color: #a4452c;
  font-weight: 700;
  margin-right: 8px;
}
.li-lead {
  font-weight: 700;
}

.end {
  margin: 30px auto 6px;
  text-align: center;
  font-size: 12px;
  letter-spacing: 4px;
  color: #a99f90;
}
