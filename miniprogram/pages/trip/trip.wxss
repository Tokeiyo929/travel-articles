/* 横屏阅读页：大图通栏 + 文字窄栏的杂志流 */

/* 自绘顶栏（app.json navigationStyle custom） */
.bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  height: 44px;
  display: flex;
  align-items: center;
  padding-left: calc(14px + env(safe-area-inset-left));
  padding-right: calc(14px + env(safe-area-inset-right));
  background: rgba(248, 244, 236, 0.94);
  border-bottom: 1px solid #e2d9c8;
}
.back {
  font-size: 13px;
  color: #a4452c;
  padding: 6px 4px;
  letter-spacing: 1px;
}
.back-hover { opacity: 0.6; }
.bar-title {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #6b6257;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bar-side { width: 72px; }

.page {
  padding: 58px 0 44px;
}

/* 文头 */
.head {
  width: 60%;
  min-width: 420px;
  margin: 0 auto 14px;
  padding-bottom: 14px;
  border-bottom: 1px solid #e2d9c8;
}
.head-title {
  margin-top: 8px;
  font-size: 26px;
  font-weight: 700;
  line-height: 1.45;
}
.head-meta {
  margin-top: 8px;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 1px;
}
.head-spots {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* 小标题 */
.h1 {
  display: flex;
  align-items: center;
  width: 60%;
  min-width: 420px;
  margin: 32px auto 10px;
}
.h1-bar {
  width: 4px;
  height: 18px;
  background: #a4452c;
  margin-right: 10px;
}
.h1-x {
  font-size: 19px;
  font-weight: 700;
}

/* 正文窄栏 */
.para {
  display: block;
  width: 60%;
  min-width: 420px;
  margin: 10px auto;
  font-size: 15px;
  line-height: 1.95;
  text-align: justify;
}

/* 图与视频 */
.fig {
  margin: 22px 0;
}
.fig-img {
  width: 100%;
  display: block;
}
.fig-img-portrait {
  height: 56vh;
}
.fig-video {
  width: 100%;
  height: 56vh;
  background: #1c1a17;
}
.fig-cap {
  margin-top: 8px;
  padding: 0 calc(16px + env(safe-area-inset-left)) 0 calc(16px + env(safe-area-inset-right));
  text-align: center;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 0.5px;
}

/* 手记清单 */
.li {
  display: flex;
  width: 60%;
  min-width: 420px;
  margin: 6px auto;
  font-size: 14px;
  line-height: 1.9;
}
.li-dot {
  color: #a4452c;
  font-weight: 700;
  margin-right: 8px;
}
.li-lead {
  font-weight: 700;
}

.end {
  margin: 42px 0 8px;
  text-align: center;
  font-size: 12px;
  letter-spacing: 4px;
  color: #a99f90;
}
