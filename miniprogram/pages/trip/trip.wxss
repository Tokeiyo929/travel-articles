/* 竖屏阅读页 · WeUI article 基准 + 微慕/酱茄文章页惯例
   正文 17px/1.8、左右 24px 内边距、图片通栏 widthFix 自然高（竖屏靠滚动消化）、标题上松下紧 */

.page {
  padding: 10px 24px 44px;
}

/* 文头 */
.head {
  padding-bottom: 14px;
  border-bottom: 1px solid #e2d9c8;
}
.head-title {
  margin-top: 6px;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.45;
}
.head-meta {
  margin-top: 8px;
  font-size: 12px;
  color: #6b6257;
  letter-spacing: 1px;
}
.head-spots {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* 小标题：上松下紧（WeUI 层级节奏） */
.h1 {
  display: flex;
  align-items: center;
  margin: 30px 0 10px;
}
.h1-bar {
  width: 4px;
  height: 19px;
  background: #a4452c;
  margin-right: 10px;
}
.h1-x {
  font-size: 20px;
  font-weight: 700;
}

/* 正文：17px / 1.8，段距约半个行高 */
.para {
  display: block;
  margin: 0 0 16px;
  font-size: 17px;
  line-height: 1.8;
  text-align: justify;
}

/* 图与视频：通栏 widthFix 自然高 */
.fig {
  margin: 10px 0 18px;
}
.fig-img {
  width: 100%;
  display: block;
  border: 1px solid #e2d9c8;
  border-radius: 2px;
}
.fig-video {
  width: 100%;
  height: 56vw;
  background: #1c1a17;
  border-radius: 2px;
}
.fig-cap {
  margin-top: 7px;
  text-align: center;
  font-size: 13px;
  color: #6b6257;
  letter-spacing: 0.5px;
}

/* 手记清单 */
.li {
  display: flex;
  margin: 6px 0;
  font-size: 16px;
  line-height: 1.8;
}
.li-dot {
  color: #a4452c;
  font-weight: 700;
  margin-right: 8px;
}
.li-lead {
  font-weight: 700;
}

.end {
  margin: 34px 0 6px;
  text-align: center;
  font-size: 12px;
  letter-spacing: 4px;
  color: #a99f90;
}
